# Frontend specific
# On the feat/multitenant fork we deploy straight from this branch (no CI
# builds dist here), so frontend/dist/ is tracked in git and must NOT be
# ignored — otherwise freshly-built hashed chunks get silently dropped on
# commit and a fresh clone serves a blank page (missing /assets/*.js).
# The negations below override the broad `dist/` rule above for this path.
!frontend/dist/
!frontend/dist/**
frontend/.cache/
*.local

# Tailwind CSS output
# **/output.css

# npm cache
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
#frontend/dist

# Windows NUL file
nul
